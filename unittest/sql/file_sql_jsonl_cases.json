    {"name": "jsonl_empty_object_rows", "fixture_utf8": "{}\n{\"id\":2}\n{}\n", "sql": "SELECT count(*), count(id) FROM read_json({path})", "expected_rows": "3\t1\n"},
    {"name": "jsonl_duplicate_decoded_keys", "fixture_utf8": "{\"a\":1,\"\\u0061\":2}\n", "sql": "SELECT count(*) FROM read_json({path})", "expected_error": 1210},
    {"name": "jsonl_nested_count", "fixture_utf8": "{\"a\":[1]}\n", "sql": "SELECT count(*) FROM read_json({path})", "expected_error": 1235},
    {"name": "jsonl_nested_object", "fixture_utf8": "{\"a\":{}}\n", "sql": "SELECT * FROM read_json({path})", "expected_error": 1235},
    {"name": "jsonl_top_level_array", "fixture_utf8": "[1,2]\n", "sql": "SELECT * FROM read_json({path})", "expected_error": 1210},
    {"name": "jsonl_leading_zero", "fixture_utf8": "{\"a\":01}\n", "sql": "SELECT * FROM read_json({path})", "expected_error": 1210},
    {"name": "jsonl_trailing_comma", "fixture_utf8": "{\"a\":1,}\n", "sql": "SELECT * FROM read_json({path})", "expected_error": 1210},
    {"name": "jsonl_bad_second_line", "fixture_utf8": "{\"a\":1}\n{\"a\":}\n", "sql": "SELECT * FROM read_json({path})", "expected_error": 1210, "error_contains": "line 2"},
    {"name": "jsonl_lone_surrogate", "fixture_utf8": "{\"a\":\"\\ud800\"}\n", "sql": "SELECT * FROM read_json({path})", "expected_error": 1210},
    {"name": "jsonl_empty_file", "fixture_utf8": "\n \t\r\n", "sql": "SELECT * FROM read_json({path})", "expected_error": 1210}
