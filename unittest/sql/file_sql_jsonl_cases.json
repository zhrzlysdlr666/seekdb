{
  "description": "Focused JSONL contracts. Write fixture_utf8 verbatim; substitute a SQL-quoted fixture path for {path}.",
  "cases": [
    {"name": "jsonl_union_bom_crlf", "fixture_utf8": "\ufeff{\"b\":1}\r\n\r\n {\"a\":\"ok\"}\r\n", "sql": "SELECT * FROM read_ndjson({path})", "expected_rows": "1\tNULL\nNULL\tok\n"},
    {"name": "jsonl_native_conflict", "fixture_utf8": "{\"a\":1}\n{\"a\":\"001\"}\n", "sql": "SELECT a FROM read_json({path})", "expected_rows": "1\n001\n"},
    {"name": "jsonl_native_string_schema", "fixture_utf8": "{\"s\":\"1\",\"b\":true,\"d\":\"2024-02-29\",\"n\":null}\n", "sql": "DESCRIBE SELECT * FROM read_json({path})", "expected_rows": "s\tVARCHAR\tNO\tNULL\tNULL\tNULL\nb\tBOOLEAN\tNO\tNULL\tNULL\tNULL\nd\tDATE\tNO\tNULL\tNULL\tNULL\nn\tVARCHAR\tYES\tNULL\tNULL\tNULL\n"},
